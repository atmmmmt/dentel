NODE_ENV=development
PORT=5100

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prootech_product

JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_FOLDER=product-platform

FRONTEND_URL=http://localhost:5180

ADMIN_EMAIL=admin@prootech.com
ADMIN_PASSWORD=<choose-a-strong-password>

# Seeded VIP clinic (scripts/seed-ayham.js)
AYHAM_PASSWORD=<choose-a-strong-password>

# ── Clinic provisioning & custom domains ─────────────────────────
PUBLIC_APP_URL=https://dash-dintist.euphoria-motiva.com
PLATFORM_HOST=dash-dintist.euphoria-motiva.com
PLATFORM_IPS=

